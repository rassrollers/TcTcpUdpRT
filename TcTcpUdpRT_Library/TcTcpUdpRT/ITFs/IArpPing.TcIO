    <Method Name="Ping" Id="{6ccc9e13-e6b9-0eb8-334f-fc7a1194e29f}">
      <Declaration><![CDATA[// Ping an IP address
METHOD Ping : BOOL // Return TRUE if succesful
VAR_INPUT
	IpAddress	: STRING(15);
	Timeout		: TIME := T#5S;
END_VAR
VAR_OUTPUT
	ReplyIpAddress	: STRING(15);
	ReplyTime		: LTIME;
END_VAR
]]></Declaration>
    </Method>
    <Method Name="ResetError" Id="{06e9aae2-424b-0ca7-196f-fe55bc65e032}">
