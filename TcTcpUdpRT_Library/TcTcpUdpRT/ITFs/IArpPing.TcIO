    <Method Name="Arp" Id="{4a9ed16f-f419-0268-3916-1444a03198b0}">
      <Declaration><![CDATA[{attribute 'hide'}
// WIP: Does not return the expected MAC address. Have to talk to Beckhoff first.

// ARP an IP address
METHOD Arp : BOOL // Return TRUE if succesful
VAR_INPUT
	IpAddress	: STRING(15);
	Timeout		: TIME := T#5S;
END_VAR
VAR_OUTPUT
	ReplyIpAddress	: STRING(15);
	ReplyTime		: LTIME;
END_VAR
]]></Declaration>
    </Method>
