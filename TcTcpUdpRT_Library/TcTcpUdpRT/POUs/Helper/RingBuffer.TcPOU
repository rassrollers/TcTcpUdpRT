<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="RingBuffer" Id="{80aea213-0d34-08b9-10ae-08e00b244947}" SpecialFunc="None">
    <Declaration><![CDATA[// The buffer uses 1-byte separation rule from the writer to the reader.
// The storage is allocated once from the TwinCAT router memory with __NEW in Init()
// and released again with __DELETE in FB_exit. Call Init() during start-up (e.g. from
// the FB_init of the owning function block) before using the buffer.
FUNCTION_BLOCK RingBuffer
VAR
	_error			: BOOL;
	_errorString	: STRING(TcTcpUdpRT_Param.ErrorStringSize);
	_pBuffer		: POINTER TO BYTE;  // Dynamically allocated storage (__NEW), 0 when not allocated
	_size			: UDINT;  // Size of the allocated storage in bytes
	_readPointer	: UDINT;
	_writePointer	: UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="CopyFromBuffer" Id="{6a33b9e1-e432-0529-12da-35921cb56c1e}">
      <Declaration><![CDATA[METHOD PRIVATE CopyFromBuffer : UDINT
VAR_INPUT
	Data	: POINTER TO BYTE;
	Length	: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CopyFromBuffer := MEMCPY(destAddr:= Data, srcAddr:= ADR(_pBuffer[_readPointer]), n:= Length);
IF CopyFromBuffer = 0 THEN
	_error := TRUE;
	_errorString := CONCAT('MEMCPY invalid parameter, ReadPointer: ', CONCAT(TO_STRING(_readPointer), CONCAT(', Length: ', CONCAT(TO_STRING(Length), CONCAT(', Data: ', TO_STRING(Data))))));
ELSIF CopyFromBuffer <> Length THEN
	_error := TRUE;
	_errorString := CONCAT('MEMCPY size ', CONCAT(TO_STRING(CopyFromBuffer), CONCAT(' from buffer is different from length ', TO_STRING(Length))));
ELSE
	_readPointer := (_readPointer + CopyFromBuffer) MOD _size;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CopyToBuffer" Id="{734a526b-f17b-0cee-1d60-c60399a92bc6}">
      <Declaration><![CDATA[METHOD PRIVATE CopyToBuffer : UDINT
VAR_INPUT
	Data	: POINTER TO BYTE;
	Length	: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CopyToBuffer := MEMCPY(destAddr:= ADR(_pBuffer[_writePointer]), srcAddr:= Data, n:= Length);
IF CopyToBuffer = 0 THEN
	_error := TRUE;
	_errorString := CONCAT('MEMCPY invalid parameter, WritePointer: ', CONCAT(TO_STRING(_writePointer), CONCAT(', Length: ', CONCAT(TO_STRING(Length), CONCAT(', Data: ', TO_STRING(Data))))));
ELSIF CopyToBuffer <> Length THEN
	_error := TRUE;
	_errorString := CONCAT('MEMCPY size ', CONCAT(TO_STRING(CopyToBuffer), CONCAT(' to buffer is different from length ', TO_STRING(Length))));
ELSE
	_writePointer := (_writePointer + CopyToBuffer) MOD _size;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="EmptyBuffer" Id="{0f7441c0-08f4-029b-0fb2-e728fac33e5d}">
      <Declaration><![CDATA[METHOD EmptyBuffer : BOOL
VAR
	set	: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _pBuffer = 0 THEN
	_error := TRUE;
	_errorString := 'Ring buffer is not allocated, call Init() first';
	RETURN;
END_IF

set := MEMSET(destAddr:= _pBuffer, fillByte:= 0, n:= _size);
IF set = _size THEN
	_readPointer := 0;
	_writePointer := 0;
	EmptyBuffer := TRUE;
ELSE
	_error := TRUE;
	_errorString := 'Failed to empty ring buffer, MEMSET to zero';
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Property Name="Error" Id="{fea8a711-26c7-0572-04dd-e66f59709a5e}">
      <Declaration><![CDATA[PROPERTY Error : BOOL]]></Declaration>
      <Get Name="Get" Id="{c70bea21-318a-0ee0-1eb0-ec5bc9e8a557}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Error := _error;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_Exit" Id="{7e5854d6-bfcc-0249-301d-0dfd76615777}">
      <Declaration><![CDATA[//FB_Exit must be implemented explicitly. If there is an implementation, then the
//method is called before the controller removes the code of the function block instance
//(implicit call). The return value is not evaluated.
METHOD FB_Exit: BOOL
VAR_INPUT
    bInCopyCode: BOOL;  // TRUE: the exit method is called in order to leave the instance which will be copied afterwards (online change).  
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInCopyCode AND _pBuffer <> 0 THEN  // No online change -> shutdown, release the router memory
	__DELETE(_pBuffer);  // Sets _pBuffer to 0
	_size := 0;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Property Name="GetError" Id="{ec835a68-a4b3-02af-0a12-dba7371b5b41}">
      <Declaration><![CDATA[PROPERTY GetError : STRING(TcTcpUdpRT_Param.ErrorStringSize)]]></Declaration>
      <Get Name="Get" Id="{afb0f6c2-cb50-02cc-1741-8bceaea93735}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[GetError := _errorString;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Init" Id="{0b601765-cd37-0d6e-1eba-2e5f436aa6d1}">
      <Declaration><![CDATA[METHOD Init : BOOL
VAR_INPUT
	BufferSize	: UDINT;  // Size of the ring buffer in bytes, 0 uses TcpUdp_Param.RingBufferSize
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _pBuffer <> 0 THEN
	Init := TRUE;  // Already allocated, allocation is only done once
	RETURN;
END_IF

IF BufferSize = 0 THEN
	BufferSize := TcTcpUdpRT_Param.RingBufferSize;
END_IF

_pBuffer := __NEW(BYTE, BufferSize);
IF _pBuffer = 0 THEN
	_size := 0;
	_error := TRUE;
	_errorString := CONCAT('Failed to allocate ring buffer of size ', CONCAT(TO_STRING(BufferSize), ' from router memory'));
	RETURN;
END_IF

_size := BufferSize;
_readPointer := 0;
_writePointer := 0;
Init := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="IsAllocated" Id="{7fa54fd6-b1aa-0988-153d-dae7ac2fc78a}">
      <Declaration><![CDATA[PROPERTY IsAllocated : BOOL]]></Declaration>
      <Get Name="Get" Id="{a1763297-7081-0978-3742-6eb8ce9ff154}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsAllocated := _pBuffer <> 0;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="IsBufferEmpty" Id="{498c0ea8-4fab-053e-39ad-7af76230e8ed}">
      <Declaration><![CDATA[PROPERTY IsBufferEmpty : BOOL]]></Declaration>
      <Get Name="Get" Id="{586b14d4-0d2b-0fe3-1d0c-45914576bc3a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _size = 0 THEN
	IsBufferEmpty := TRUE;
	RETURN;
END_IF
IsBufferEmpty := (TO_LINT((_readPointer - _writePointer + _size) MOD _size) - 1) = -1;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="IsBufferFull" Id="{9d03a104-eaae-0564-219e-1d2fcbe3ca33}">
      <Declaration><![CDATA[PROPERTY IsBufferFull : BOOL]]></Declaration>
      <Get Name="Get" Id="{85385786-b48e-07e7-1288-5b9d6586232e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _size = 0 THEN
	IsBufferFull := FALSE;
	RETURN;
END_IF
IsBufferFull := (TO_LINT((_readPointer - _writePointer + _size) MOD _size) - 1) = 0;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Read" Id="{91db3c69-5cde-0009-0fda-a86128231982}">
      <Declaration><![CDATA[METHOD Read : UDINT
VAR_INPUT
	Data	: POINTER TO BYTE;
	Length	: UDINT;
END_VAR
VAR
	copied	: UDINT;
	first	: UDINT;
	second	: UDINT;
	available	: UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _pBuffer = 0 THEN
	_error := TRUE;
	_errorString := 'Ring buffer is not allocated, call Init() first';
	RETURN;
ELSIF Data = 0 THEN
	Read := 0;
	_error := TRUE;
	_errorString := 'Was not able to read from buffer because data pointer was empty';
	RETURN;
ELSIF Length = 0 THEN
	Read := 0;
	_error := TRUE;
	_errorString := 'Was not able to read from buffer because length was zero';
	RETURN;
END_IF

IF _readPointer = _writePointer THEN
	// No data to be read
    Read := 0;
    RETURN;
END_IF

available := (_writePointer - _readPointer + _size) MOD _size;
IF Length > available THEN
	// Only read available data
	Length := available;
END_IF

IF _readPointer + Length <= _size THEN
	// No wrap around
	Read := CopyFromBuffer(Data:= Data, Length:= Length);
ELSE
	// Wrap around
	first := _size - _readPointer;
	copied := CopyFromBuffer(Data:= Data, Length:= first);
	Read := copied;
	
	IF _error THEN
		RETURN;
	END_IF
	
	second := Length - first;
	copied := CopyFromBuffer(Data:= ADR(Data[first]), Length:= second);
	Read := Read + copied;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetError" Id="{58940d66-7c5c-0e58-300e-860cb6cedc43}">
      <Declaration><![CDATA[METHOD ResetError
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_error := FALSE;
_errorString := '';
]]></ST>
      </Implementation>
    </Method>
    <Property Name="Size" Id="{714e2a7e-e26f-0fdc-01d8-fb7cc8023c64}">
      <Declaration><![CDATA[PROPERTY Size : UDINT]]></Declaration>
      <Get Name="Get" Id="{821141e8-0409-0d10-2bce-2d6bfc2f094c}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Size := _size;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Write" Id="{419acdf9-7d69-0db9-0ffa-9999d3b7b3cc}">
      <Declaration><![CDATA[METHOD Write : UDINT
VAR_INPUT
	Data	: POINTER TO BYTE;
	Length	: UDINT;
END_VAR
VAR
	copied	: UDINT;
	first	: UDINT;
	second	: UDINT;
	available	: LINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _pBuffer = 0 THEN
	_error := TRUE;
	_errorString := 'Ring buffer is not allocated, call Init() first';
	RETURN;
ELSIF Data = 0 THEN
	Write := 0;
	_error := TRUE;
	_errorString := 'Was not able to write to buffer because data pointer was empty';
	RETURN;
ELSIF Length = 0 THEN
	Write := 0;
	_error := TRUE;
	_errorString := 'Was not able to write to buffer because length was zero';
	RETURN;
END_IF

IF IsBufferEmpty THEN
	available := _size - 1;
ELSE
	available := TO_LINT((_readPointer - _writePointer + _size) MOD _size) - 1;
END_IF

IF Length > available THEN 
	// Not enough space available
	Write := 0;
	_error := TRUE;
	_errorString := CONCAT('Ring buffer write overflow, available: ', CONCAT(TO_STRING(available), CONCAT(', length: ', TO_STRING(Length))));
	RETURN;
END_IF

IF (_writePointer + Length) <= _size THEN
	// No wrap around
	Write := CopyToBuffer(Data:= Data, Length:= Length);
ELSE
	// Wrap around
	first := _size - _writePointer;
	copied := CopyToBuffer(Data:= Data, Length:= first);
	Write := copied;
	
	IF _error THEN
		RETURN;
	END_IF
	
	second := Length - first;
	copied := CopyToBuffer(Data:= ADR(Data[first]), Length:= second);
	Write := Write + copied;
END_IF
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>